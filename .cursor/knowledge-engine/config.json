  "sourcePriority": [
    { "tier": 1, "label": "Official vendor documentation", "minConfidence": 0.95 },
    { "tier": 2, "label": "Standards organizations & government", "minConfidence": 0.9 },
    { "tier": 3, "label": "Academic & verified benchmarks", "minConfidence": 0.85 },
    { "tier": 4, "label": "Established consulting & engineering blogs", "minConfidence": 0.75 },
    { "tier": 5, "label": "Conference material & technical books", "minConfidence": 0.7 },
    { "tier": 6, "label": "Community sources", "minConfidence": 0.5, "requiresCrossRef": true }
  ],
  "qualityGates": {
    "minConfidence": 0.6,
    "requireSource": true,
    "maxDuplicateSimilarity": 0.85,
    "requiredSections": ["summary", "coreConcepts", "bestPractices", "references"]
  },
  "rules": [
    "Always cite evidence",
    "Never hallucinate",
    "Research first",
    "Challenge assumptions",
    "Think from first principles",
    "Benchmark competitors",
    "Estimate ROI",
    "Explain reasoning",
    "Generate implementation plan",
    "Assign confidence score",
    "Fact-check before reporting",
    "Never duplicate findings"
  ],
  "selfImprovementQuestions": [
    "What new concepts appeared?",
    "What knowledge is outdated?",
    "What contradictions exist?",
    "What patterns are emerging?",
    "What should be researched next?"
  ]
}
