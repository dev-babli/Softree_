{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "atlas/knowledge-atom",
  "title": "ATLAS Knowledge Atom",
  "type": "object",
  "required": [
    "id", "title", "category", "domain", "summary", "confidence", "version", "lastUpdated"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
    "title": { "type": "string", "minLength": 3 },
    "category": { "type": "string", "enum": ["atom", "pattern", "playbook", "framework", "competitor", "rubric", "template", "prompt"] },
    "domain": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "summary": { "type": "string", "minLength": 20 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "lastUpdated": { "type": "string", "format": "date" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "ref", "confidence"],
        "properties": {
          "type": { "type": "string", "enum": ["internal", "url", "book", "standard", "academic", "observation"] },
          "ref": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "retrievedAt": { "type": "string", "format": "date" }
        }
      }
    },
    "related": { "type": "array", "items": { "type": "string" } },
    "supersedes": { "type": "string" },
    "futureResearch": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string", "enum": ["draft", "verified", "deprecated"], "default": "verified" }
  }
}
