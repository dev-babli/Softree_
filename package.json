        "audit:site": "npx unlighthouse --site https://softreetechnology.com",
        "audit:local": "npx lighthouse http://localhost:3000 --only-categories=performance,accessibility,seo,best-practices --view",
        "analyze": "cross-env ANALYZE=true npm run build",
        "generate:og": "node scripts/generate-og-screenshots.mjs",
        "fetch:certifications": "node scripts/fetch-certification-images-puppeteer.mjs",
