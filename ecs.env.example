# Copy names into Amplify console env vars (and ECS if you still use it).
# Do not put real values in this file.

# Amplify-only: Incoming webhook URL so Sanity publish triggers a rebuild
# (Amplify does not support on-demand ISR).
AMPLIFY_REBUILD_WEBHOOK_URL=

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Public — baked in at docker build time for NEXT_PUBLIC_*
NEXT_PUBLIC_SITE_URL=https://staging.softreetechnology.com
NEXT_PUBLIC_SANITY_PROJECT_ID=1zmh4sfw
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-05-21
NEXT_PUBLIC_SANITY_STUDIO_URL=https://staging.softreetechnology.com/studio
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_CALENDLY_URL=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Secrets Manager (valueFrom) — never bake into the image
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=
CONTENT_PIPELINE_SECRET=
GEMINI_API_KEY=
GOOGLE_GENAI_API_KEY=
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_PLUGIN_API_KEY=
WEB3FORMS_ACCESS_KEY=
SLACK_WEBHOOK_URL=
SENTRY_AUTH_TOKEN=
SENTRY_DSN=
POSTHOG_PERSONAL_API_KEY=
GSC_SERVICE_ACCOUNT_JSON=
PSI_API_KEY=
