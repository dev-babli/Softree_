        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"topic\": \"{{$json.topic || ''}}\", \"autoPublish\": false, \"generateImages\": true, \"useArena\": true}"
      },
      "id": "http-pipeline",
      "name": "Run Softree Pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [280, 0]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [[{ "node": "Run Softree Pipeline", "type": "main", "index": 0 }]]
    }
  },
  "meta": {
    "templateCredsSetupCompleted": true
  }
