{
  "name": "project-neo",
  "version": "1.0.0",
  "private": true,
  "description": "AI-native Agency Platform - CMS Replacement",
  "workspaces": [
    "packages/*",
    "frontend",
    "studio",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:frontend": "turbo dev --filter=frontend",
    "dev:studio": "turbo dev --filter=studio",
    "dev:custom-studio": "turbo dev --filter=custom-studio",
    "build": "turbo build",
    "build:frontend": "turbo build --filter=frontend",
    "build:studio": "turbo build --filter=studio",
    "build:custom-studio": "turbo build --filter=custom-studio",
    "lint": "turbo lint",
    "lint:frontend": "turbo lint --filter=frontend",
    "lint:studio": "turbo lint --filter=studio",
    "lint:custom-studio": "turbo lint --filter=custom-studio",
    "typecheck": "turbo typecheck",
    "typecheck:frontend": "turbo typecheck --filter=frontend",
    "typecheck:studio": "turbo typecheck --filter=studio",
    "typecheck:custom-studio": "turbo typecheck --filter=custom-studio",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.4",
    "prettier": "^3.3.0",
    "turbo": "^2.10.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@11.6.2"
}
